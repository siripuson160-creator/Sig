####################################################################
# Copy to .env and fill in. Never commit the filled-in file.
#   cp .env.example .env && chmod 600 .env
####################################################################

# ------------------------------------------------------------ general
TIMEZONE=Asia/Bangkok
LOG_LEVEL=INFO

# ----------------------------------------------------------- database
# MVP (single VPS):
DATABASE_URL=sqlite+aiosqlite:///./data/signals.db
# Production:
# DATABASE_URL=postgresql+asyncpg://signal:CHANGE_ME@localhost:5432/signals

# ----------------------------------------------------------- telegram
# From https://my.telegram.org -> API development tools.
# These identify the *application*, not your account.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Where the login session is stored. Treat this file like a password:
# anyone holding it is logged into your Telegram account.
TELEGRAM_SESSION=./data/telegram.session

# The source group. Run `python -m app.cli chats` to list ids.
# Supergroups look like -1001234567890.
TELEGRAM_SOURCE_CHAT_ID=

# Optional additional sources, comma separated. Normally left empty.
TELEGRAM_EXTRA_CHAT_IDS=

# NOTE: there is no setting for your phone number, login code or 2FA
# password, and there never will be. You type those once, yourself,
# during `python -m app.cli login`.

# --------------------------------------------------------------- line
# LINE Developers console -> Messaging API channel -> long-lived token.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# Group id to post into. Invite the channel's bot to the group, then read
# the groupId from a webhook event (see docs/OPERATIONS.md).
LINE_GROUP_ID=
LINE_ENABLED=true
# Prefix added to every forwarded edit. Set ADD_EDITED_PREFIX=false to send
# edits without the marker.
ADD_EDITED_PREFIX=true
LINE_EDIT_PREFIX=EDITED
# Retries wait 2s, 5s then 10s before the message is marked FAILED.
LINE_MAX_ATTEMPTS=3

# ------------------------------------------------------------- prices
# none        - no price feed; signals stay at PENDING_RESULT (MVP default)
# csv         - OHLC files in PRICE_CSV_PATH, e.g. XAUUSD_1m.csv
# twelvedata  - Twelve Data API (needs PRICE_API_KEY)
PRICE_DATA_PROVIDER=none
PRICE_SYMBOL=XAUUSD
PRICE_TIMEFRAME=1m
PRICE_DRILLDOWN_TIMEFRAME=1m
PRICE_API_KEY=
PRICE_CSV_PATH=./data/prices
# The unit every published statistic is in, and what one pip is worth in price.
# Their ratio carries the convention Thai desks count gold by: ten points to
# the pip, so a source posting "+70Pips" is published as +700 — the number its
# members already read it as. Change one without the other and every figure is
# out by a factor of ten, so the service checks the pair at every start and
# says so on the settings page if it no longer holds.
POINT_SIZE=0.01
PIP_SIZE=0.1

# --------------------------------------------------------- evaluation
# What to do when one candle contains both the take profit and the stop
# loss and the order cannot be established:
#   SL_FIRST   - assume the stop loss came first (conservative, default)
#   TP_FIRST   - assume the take profit came first
#   AMBIGUOUS  - record as AMBIGUOUS and exclude from the win rate
AMBIGUITY_RULE=SL_FIRST

# BEST_TP     - a stop loss touched after a take profit is booked at that
#               take profit (default)
# FIRST_TOUCH - the first level touched ends the trade
RESULT_MODE=BEST_TP

ENTRY_FILL_WINDOW_HOURS=12
SIGNAL_EXPIRY_HOURS=72
RESULT_ENGINE_INTERVAL_SECONDS=60

# ---------------------------------------------------------- test mode
# true = receive, parse and store everything as normal, but never push to
# LINE. Use it to watch the parser and the dashboard before going live.
DRY_RUN=false

# ---------------------------------------------------------------- api
API_HOST=0.0.0.0
API_PORT=8000
# Password for the /admin sign-in page. Generate with: openssl rand -hex 24
# Leave empty to disable the admin surface entirely.
ADMIN_PASSWORD=
# Optional machine key for scripts calling /api/admin/* directly.
ADMIN_API_KEY=
ADMIN_SESSION_HOURS=12
CORS_ORIGINS=*
# How often the dashboard refreshes itself, in seconds.
DASHBOARD_REFRESH_SECONDS=10

# ------------------------------------------------------------ logging
# Empty = stdout only (journald rotates it for you under systemd).
# Set a path to also write a rotating file, e.g. ./logs/app.log
LOG_FILE=
LOG_MAX_BYTES=10000000
LOG_BACKUP_COUNT=7
